// ~/.config/waybar/config-hyprland.jsonc
//
// Hyprland variant of config.jsonc. Identical except for the two
// compositor-specific modules:
//   sway/workspaces -> hyprland/workspaces   (focused button class: .active)
//   sway/mode       -> hyprland/submap
//
// Launched from hyprland.lua as: waybar -c ~/.config/waybar/config-hyprland.jsonc
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "reload_style_on_change": true,

    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/weather", "network", "power-profiles-daemon", "battery", "pulseaudio"],

    "hyprland/workspaces": {
        // no "enable-bar-scroll" == sway's "disable-scroll": true
        "all-outputs": false,
        "sort-by": "number",
        "format": "{name}"
    },

    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>",
        "tooltip": false
    },

    "clock": {
        "interval": 1,
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 1800,
        "tooltip": true
    },

    "network": {
        "format-wifi": "\uf1eb  {essid} ({signalStrength}%)",
        "format-ethernet": "\uef44  {ifname}",
        "format-linked": "\uef44  {ifname} (no IP)",
        "format-disconnected": "⚠ disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "~/.config/waybar/scripts/network-menu.sh",
        "on-click-right": "ghostty -e nmtui"
    },

    "power-profiles-daemon": {
        // Native module, talks D-Bus to tuned-ppd / power-profiles-daemon.
        // Left click: next profile, right click: previous. It handles clicks
        // itself, so on-click* options are ignored; use the keybinding for a menu.
        // Default tooltip shows profile + driver. If overriding tooltip-format,
        // waybar 0.15 only knows {profile}, {driver}, {icon}; anything else
        // throws and silently hides the module.
        "format": "{icon}",
        "format-icons": {
            // Escapes keep this file ASCII-only: rocket, balance-scale, leaf, bolt
            "performance": "\uf135",
            "balanced": "\uf24e",
            "power-saver": "\uf06c",
            "default": "\uf0e7"
        }
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{timeTo}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\ueee8 muted",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
